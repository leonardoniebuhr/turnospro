# --- Base de datos (PostgreSQL obligatorio) ---
# Local: levantá Postgres con `docker compose up -d` y usá:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turnospro?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/turnospro?schema=public"
# Producción gratuita: creá un proyecto en https://neon.tech, copiá la connection string y pegala en Render (Environment). Ejemplo:
# DATABASE_URL="postgresql://usuario:clave@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Neon suele darte 2 URLs:
# - Pooled (host con -pooler) → usala como DATABASE_URL
# - Direct/Unpooled (host sin -pooler) → usala como DIRECT_URL

# JWT_SECRET: obligatorio en producción (string largo y aleatorio)
JWT_SECRET="supersercret_change_this_in_production"

# Puerto (Render inyecta PORT automáticamente)
# PORT=3000

# Opcional — IA / enlaces
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Primer arranque local ---
# docker compose up -d
# copiá este archivo a .env y ajustá DATABASE_URL si hace falta
# npx prisma db push
# npm run seed
# npm run dev

# --- Deploy Render (gratis) ---
# Subí el repo a GitHub → Render → New Blueprint → render.yaml
# En Environment definí DATABASE_URL (Neon) y JWT_SECRET
# Tras el primer deploy exitoso: Render Shell → npx prisma db push && npm run seed
